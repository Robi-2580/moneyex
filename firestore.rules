rules_version = '2';

// PaysaPro — per-user data isolation.
// Every document lives under users/{userId}/... and may only be
// read or written by the signed-in owner of that userId.
// Anything outside users/{userId} is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Profile document (isDark, language, fontFamily)
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      // All subcollections: wallets, categories, transactions,
      // budgets, loans (and any future ones)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
